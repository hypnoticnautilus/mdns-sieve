#!/sbin/openrc-run

name="mdns-sieve-gui"
description="mDNS Sieve Web GUI"

command="/opt/mdns-sieve/venv/bin/python3"
command_args="-u -m mdns_sieve_gui.main -c /etc/mdns-sieve.yaml"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"

output_log="/var/log/mdns-sieve-gui.log"
error_log="/var/log/mdns-sieve-gui.log"

depend() {
	need net
	after mdns-sieve
}
