#!/sbin/openrc-run

name="mdns-sieve"
description="mDNS Sieve Reflector Daemon"

command="/usr/local/bin/mdns-sieve"
command_args="--config /etc/mdns-sieve.yaml"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"

output_log="/var/log/mdns-sieve.log"
error_log="/var/log/mdns-sieve.log"

depend() {
	need net
	after firewall
}
